# Copy this file to .env.local and fill your own values.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=8000

# Storage backend: jsonl keeps local files; supabase writes to Supabase Postgres.
STORAGE_BACKEND=jsonl

# Supabase Postgres connection.
# Recommended for local IPv4 networks: use the Session Pooler connection info
# from Supabase Dashboard -> Connect -> Session pooler.
#
# Option A: paste the full connection string.
SUPABASE_DB_URL=
#
# Option B: fill parts instead of SUPABASE_DB_URL.
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
SUPABASE_CONNECT_RETRIES=5

# The app stores data in this private schema and creates tables automatically.
SUPABASE_DB_SCHEMA=app_private
SUPABASE_TABLE_PREFIX=ai_script
